; hpfxl.inf
;
; Installation inf for the Hewlett-Packard VisualizeFX video drivers.
;


[Version]
Signature="$Windows NT$"
Provider=%Mfg%
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
CatalogFile=hpfxl.cat
DriverVer=03/02/2002,03.02.2002.118


[DestinationDirs]
DefaultDestDir         = 11
hpVisualizeFX.Miniport = 12  ; drivers
hpVisualizeFX.Miniport.copy = 12  ; drivers
hpVisualizeFX.Miniport.del = 12  ; drivers
hpVisualizeFX.diags = 10,HPDiag  ; \Winnt\HPDiag
hpVisualizeFX.diags.copy = 10,HPDiag  ; \Winnt\HPDiag
hpVisualizeFX.diags.del = 10,HPDiag  ; \Winnt\HPDiag

;
; Driver information
;

[Manufacturer]
%Mfg% = Mfg.HP

; The Device section
[Mfg.HP]
Hewlett-Packard VisualizeFX Series Video = hpVisualizeFX, PCI\VEN_103C&DEV_100A&SUBSYS_10D4103C&REV_80, PCI\VEN_103C&DEV_100A&SUBSYS_10D5103C&REV_80, PCI\VEN_103C&DEV_100A&SUBSYS_10D6103C&REV_80, PCI\VEN_103C&DEV_100A&SUBSYS_10D7103C&REV_80, PCI\VEN_103C&DEV_100A&SUBSYS_10D8103C&REV_80

[hpVisualizeFX.Startup.del]
HpVisIni.exe,,,0x0001000

[hpVisualizeFX.Startup.copy]
HpVisIni.exe,,,0x0000000


;
; Service Installation
;

[hpVisualizeFX.Services]
AddService = hpVisualizeFX, 0x00000002, hpVisualizeFX_Service_Inst, hpVisualizeFX_EventLog_Inst

[hpVisualizeFX_Service_Inst]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 1                  ; SERVICE_SYSTEM_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\hpfxlmp.sys

[hpVisualizeFX_EventLog_Inst]
AddReg = hpVisualizeFX_EventLog_AddReg

[hpVisualizeFX_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\hpfxlmp.sys
HKR,,TypesSupported,0x00010001,7


;
; Software Installation
;

[hpVisualizeFX.SoftwareSettings]
AddReg = hpVisualizeFX_OglIcd_SoftwareDeviceSettings
AddReg = hpVisualizeFX_OS_SoftwareDeviceSettings
AddReg = hpVisualizeFX_ShellExtensionSettings
AddReg = hpVisualizeFX_DefaultDriverConfig
AddReg = hpVisualizeFX_PTCProE_config
AddReg = hpVisualizeFX_PTCOther_config
AddReg = hpVisualizeFX_AVS_config
AddReg = hpVisualizeFX_Catia_config
AddReg = hpVisualizeFX_CATWeb_config
AddReg = hpVisualizeFX_Unigraphics_config
AddReg = hpVisualizeFX_SDRC_config
AddReg = hpVisualizeFX_SolidDesigner_config
AddReg = hpVisualizeFX_SolidWorks_config
AddReg = hpVisualizeFX_SoftImage_config
AddReg = hpVisualizeFX_3DStudioMax_config
AddReg = hpVisualizeFX_LightWave3D_config
AddReg = hpVisualizeFX_Alias|WavefrontMaya_config
AddReg = hpVisualizeFX_Alias|WavefrontStudioTools_config
AddReg = hpVisualizeFX_Alias|WavefrontSpider_config
AddReg = hpVisualizeFX_Compatibility_config
AddReg = hpVisualizeFX_MaxPerformance_config
AddReg = hpVisualizeFX_Deneb_config
AddReg = hpVisualizeFX_EAI_config
AddReg = hpVisualizeFX_AutodeskInventor_config
AddReg = hpVisualizeFX_SolidEdge_config
AddReg = hpVisualizeFX_Opticore_config
AddReg = hpVisualizeFX_Houdini_config
AddReg = hpVisualizeFX_cleanup

[hpVisualizeFX_DefaultDriverConfig]
HKLM, %DriverConfig%, Config,					%REG_SZ%,			*Compatibility Mode
HKLM, %DriverConfig%, GammaBlue,				%REG_DWORD%,		0x64
HKLM, %DriverConfig%, GammaGreen,				%REG_DWORD%,		0x64
HKLM, %DriverConfig%, GammaRed,					%REG_DWORD%,		0x64
HKLM, %DriverConfig%, AllowGammaPage,			%REG_SZ%,			TRUE
HKLM, %DriverConfig%, AllowOptionsPage,			%REG_SZ%,			TRUE
HKLM, %DriverConfig%, AllowUserConfigs,			%REG_SZ%,			TRUE
HKLM, %DriverConfig%, LockSliders,				%REG_SZ%,			TRUE

;
; The DefaultDriverConfig and the "*Compatibility Mode" config 
; MUST have all registry variables defined that can affect ANY 
; application. Other application configs need only define registry 
; variables which are different than the compatibility mode setting. 
; When you hit apply in the Display Properties Options panel, it 
; will first apply the compatibility mode config and then apply the 
; intended configuration. By first applying compatibility mode, it 
; ensures that all registry variables are set to known values so 
; you don't inherit the previous config's value for any variable 
; not referenced in the new config.
;
; If a config or a registry variable becomes obsolete please
; add it to the hpVisualizeFX_cleanup section found below
; When HpVisIni sees something in the remove part of the registry
; It will automatically attempt to remove those configs/variables
; from the registry. Decided to do it this way because INF cannot
; Find all the users properly, nor can it remove the directory nodes
; 

HKLM, %DriverConfig%, NoTearing,				%REG_SZ%,			FALSE
HKLM, %DriverConfig%, FastBufferSwaps,			%REG_SZ%,			FALSE
HKLM, %DriverConfig%, EnableFastImageClear,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, EnableFastZClear,			%REG_SZ%,			FALSE
HKLM, %DriverConfig%, HPOGL_LIGHTING_SPACE,		%REG_SZ%,			OC
HKLM, %DriverConfig%, HPOGL_OPTIMIZE_DL_EXECUTION,	%REG_SZ%,		FALSE
HKLM, %DriverConfig%, SHADOW_VAPI_STATE,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, DrawAllGdiBuffers,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, StereoSyncEnabled,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, ACCUM_AUTO_RETURN,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, RenderQuadBowties,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, NO_OGL_CLIP,				%REG_SZ%,			FALSE
HKLM, %DriverConfig%, SoftImageOverlay,			%REG_SZ%,			FALSE
HKLM, %DriverConfig%, NUM_USER_CDBUFFERS,		%REG_DWORD%,		3
HKLM, %DriverConfig%, FLAT_COLORMAT_FIX,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, MS_Conformant_Overlays,	%REG_SZ%,			TRUE
HKLM, %DriverConfig%, DISABLE_PGON_LINE_INTLK,	%REG_SZ%,			FALSE
HKLM, %DriverConfig%, HPOGL_FORCE_SCENEAA,		%REG_SZ%,			FALSE
HKLM, %DriverConfig%, HPOGL_TEX_VPC_1, 			%REG_DWORD%,		0x04040606


